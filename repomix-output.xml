"use client";

import { useEffect, useState, useMemo } from "react";
import Link from "next/link";
import { supabase } from "../lib/supabase";
import {
  Menu,
  Search,
  Flame,
  Globe,
  School,
  Landmark,
  Cpu,
  Vote,
  MessageSquare,
  Heart,
  Calendar,
  Gamepad2,
  Music,
  Film,
  Trophy,
  User,
  Medal,
  Newspaper,
  ChevronRight,
  Clock,
  X,
  Play,
  TrendingUp,
} from "lucide-react";

export default function HomePage() {
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [user, setUser] = useState(null);
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedCategory, setSelectedCategory] = useState("Tutti");
  const [voted, setVoted] = useState(false);
  const [pollVotes, setPollVotes] = useState({ yes: 62, no: 38, total: 128 });

  // Gestione Auth Supabase
  useEffect(() => {
    async function loadUser() {
      try {
        const {
          data: { session },
        } = await supabase.auth.getSession();
        setUser(session?.user ?? null);

        const {
          data: { subscription },
        } = supabase.auth.onAuthStateChange((_event, session) => {
          setUser(session?.user ?? null);
        });

        return () => subscription?.unsubscribe();
      } catch (err) {
        console.warn("Gestione sessione Supabase:", err);
      }
    }

    loadUser();
  }, []);

  const categories = [
    "Tutti",
    "Attualità",
    "Vita scolastica",
    "Tecnologia",
    "Sport",
    "Cultura",
    "Interviste",
    "Eventi",
  ];

  // Lista articoli estesa con copertine, visualizzazioni e flag trending
  const articles = [
    {
      id: 1,
      title: "L'intelligenza artificiale entra nella didattica del Liceo",
      subtitle: "Vox discipulorum: la rivoluzione digitale nelle aule.",
      summary:
        "Analisi sull'impatto dei nuovi modelli generativi nelle aule scolastiche: risorse, sfide e opinioni di studenti e docenti.",
      category: "Tecnologia",
      author: "Redazione",
      time: "8 min",
      views: 1420,
      isTrending: true,
      date: "VENERDÌ 18 OTTOBRE MMXXVI",
      coverUrl: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1000&auto=format&fit=crop",
    },
    {
      id: 2,
      title: "Inaugurato il nuovo laboratorio STEM al Salvemini",
      summary:
        "Attrezzature all'avanguardia per la robotica e il calcolo ad alte prestazioni a disposizione delle classi prime.",
      category: "Vita scolastica",
      author: "Pier",
      time: "4 min",
      views: 890,
      isTrending: false,
      coverUrl: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?q=80&w=600&auto=format&fit=crop",
    },
    {
      id: 3,
      title: "Torneo d'Istituto di basket: al via le fasi eliminatorie",
      summary:
        "Squadre pronte a disputare le selezioni per le finali di fine quadrimestre. Tutte le date e i gironi.",
      category: "Sport",
      author: "Redazione",
      time: "5 min",
      views: 1100,
      isTrending: false,
      coverUrl: "https://images.unsplash.com/photo-1546519638-68e109498ffc?q=80&w=600&auto=format&fit=crop",
    },
    {
      id: 4,
      title: "Assemblea d'Istituto: approvato il piano eventi della Primavera",
      summary:
        "Dai concerti acustici ai dibattiti sull'attualità geopolitica: ecco le iniziative votate dagli studenti.",
      category: "Eventi",
      author: "Comitato Studentesco",
      time: "6 min",
      views: 640,
      isTrending: false,
      coverUrl: "https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=600&auto=format&fit=crop",
    },
    {
      id: 5,
      title: "Scuola e democrazia: il dibattito sulla rappresentanza",
      summary:
        "Riflessione critica sul ruolo della partecipazione attiva nelle istituzioni scolastiche di oggi.",
      category: "Attualità",
      author: "Elena M.",
      time: "7 min",
      views: 520,
      isTrending: false,
      coverUrl: "https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=600&auto=format&fit=crop",
    },
  ];

  // Algoritmo di selezione dell'articolo di tendenza (stile YouTube top trending)
  const trendingArticle = useMemo(() => {
    return (
      articles.find((a) => a.isTrending) ||
      [...articles].sort((a, b) => b.views - a.views)[0]
    );
  }, [articles]);

  const navigationSections = [
    {
      title: "ESPLORA",
      items: [
        { icon: School, label: "Vita scolastica", category: "Vita scolastica" },
        { icon: Newspaper, label: "Attualità", category: "Attualità" },
        { icon: Landmark, label: "Politica", category: "Politica" },
        { icon: Globe, label: "Mondo", category: "Mondo" },
        { icon: Cpu, label: "Tecnologia", category: "Tecnologia" },
      ],
    },
    {
      title: "STUDENTI",
      items: [
        { icon: Vote, label: "Vox Populi", href: "#vox-populi" },
        { icon: MessageSquare, label: "Rumors", href: "#" },
        { icon: Heart, label: "Relazioni", href: "#" },
        { icon: Calendar, label: "Eventi", category: "Eventi" },
      ],
    },
    {
      title: "INTRATTENIMENTO",
      items: [
        { icon: Gamepad2, label: "Gaming", category: "Gaming" },
        { icon: Music, label: "Musica", category: "Musica" },
        { icon: Film, label: "Cinema e Serie", category: "Cinema" },
        { icon: Trophy, label: "Sport", category: "Sport" },
      ],
    },
    {
      title: "ACCOUNT",
      items: [
        { icon: User, label: "Profilo", href: "/profilo" },
        { icon: Medal, label: "Classifica", href: "/classifica" },
      ],
    },
  ];

  const filteredArticles = useMemo(() => {
    return articles.filter((article) => {
      const matchesCategory =
        selectedCategory === "Tutti" || article.category === selectedCategory;
      const matchesSearch =
        article.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
        article.summary.toLowerCase().includes(searchQuery.toLowerCase()) ||
        article.category.toLowerCase().includes(searchQuery.toLowerCase()) ||
        article.author.toLowerCase().includes(searchQuery.toLowerCase());
      return matchesCategory && matchesSearch;
    });
  }, [searchQuery, selectedCategory]);

  const handleVote = (option) => {
    if (voted) return;
    setVoted(true);
    setPollVotes((prev) => ({
      ...prev,
      total: prev.total + 1,
      yes: option === "yes" ? prev.yes + 1 : prev.yes,
      no: option === "no" ? prev.no + 1 : prev.no,
    }));
  };

  return (
    <div className="flex min-h-screen bg-[#0A0A0A] text-white font-sans antialiased">
      {/* SIDEBAR */}
      <aside
        className={`${
          sidebarOpen ? "w-64" : "w-20"
        } bg-[#111111] border-r border-zinc-800/80 transition-all duration-300 flex flex-col shrink-0 sticky top-0 h-screen z-30`}
      >
        <div className="p-4 flex items-center justify-between border-b border-zinc-800/60 h-16">
          <button
            onClick={() => setSidebarOpen(!sidebarOpen)}
            className="p-2 text-zinc-400 hover:text-white rounded-lg hover:bg-zinc-800/60 transition"
            aria-label="Toggle Sidebar"
          >
            <Menu size={22} />
          </button>

          {sidebarOpen && (
            <Link href="/" className="flex flex-col leading-none">
              <span className="text-[#C5A46D] text-2xl font-serif font-bold tracking-tight">
                S.
              </span>
              <span className="text-[9px] text-zinc-500 tracking-[0.3em] uppercase font-sans">
                Times
              </span>
            </Link>
          )}
        </div>

        <div className="flex-1 overflow-y-auto px-3 py-4 space-y-6 custom-scrollbar">
          {navigationSections.map((section, idx) => (
            <div key={idx} className="space-y-1">
              {sidebarOpen && (
                <h4 className="px-3 text-[10px] font-mono tracking-[0.2em] uppercase text-[#C5A46D] font-bold mb-2">
                  {section.title}
                </h4>
              )}

              {section.items.map((item) => {
                const isCategory = !!item.category;
                const isActive =
                  isCategory && selectedCategory === item.category;

                const content = (
                  <div
                    onClick={() => {
                      if (isCategory) setSelectedCategory(item.category);
                    }}
                    className={`flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition cursor-pointer ${
                      isActive
                        ? "bg-[#C5A46D]/15 text-[#C5A46D] border border-[#C5A46D]/30"
                        : "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/50"
                    }`}
                  >
                    <item.icon
                      size={18}
                      className={isActive ? "text-[#C5A46D]" : "text-zinc-400"}
                    />
                    {sidebarOpen && <span>{item.label}</span>}
                  </div>
                );

                return item.href ? (
                  <Link key={item.label} href={item.href}>
                    {content}
                  </Link>
                ) : (
                  <div key={item.label}>{content}</div>
                );
              })}
            </div>
          ))}
        </div>
      </aside>

      {/* CONTENUTO PRINCIPALE */}
      <main className="flex-1 flex flex-col min-w-0">
        {/* NAVBAR */}
        <header className="h-16 border-b border-zinc-800/80 flex items-center justify-between px-8 bg-[#0A0A0A]/90 backdrop-blur sticky top-0 z-20">
          <Link href="/" className="group">
            <h1 className="text-xl sm:text-2xl font-serif font-bold text-[#C5A46D] tracking-wide group-hover:opacity-90 transition">
              Salvemini Times
            </h1>
          </Link>

          {user ? (
            <Link href="/profilo">
              <div className="w-10 h-10 rounded-full bg-[#C5A46D] text-black font-serif font-bold flex items-center justify-center hover:scale-105 transition shadow-sm">
                {user.email?.charAt(0).toUpperCase()}
              </div>
            </Link>
          ) : (
            <Link
              href="/login"
              className="px-5 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-sm font-medium transition border border-zinc-700/50"
            >
              Accedi
            </Link>
          )}
        </header>

        {/* BARRA DI RICERCA */}
        <div className="px-8 pt-6 pb-2">
          <div className="relative max-w-3xl">
            <Search
              className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400"
              size={18}
            />
            <input
              type="text"
              placeholder="🔍 Cerca articoli, eventi, studenti..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full bg-[#151515] border border-zinc-800 text-white placeholder-zinc-500 rounded-2xl pl-12 pr-10 py-3.5 text-sm focus:outline-none focus:border-[#C5A46D]/80 transition shadow-inner"
            />
            {searchQuery && (
              <button
                onClick={() => setSearchQuery("")}
                className="absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-white p-1"
              >
                <X size={16} />
              </button>
            )}
          </div>
        </div>

        {/* HERO (67% - TRENDING ALGORITMICO + COPERTINA) + VOX POPULI (33%) */}
        <section className="px-8 pt-4">
          <div className="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6 items-stretch">
            
            {/* IN EVIDENZA: SCHEDA CLICCABILE CON ANTEPRIMA COPERTINA */}
            <Link
              href={`/articolo/${trendingArticle.id}`}
              className="group block h-full"
            >
              <div className="h-full rounded-3xl bg-[#151515] border border-zinc-800 p-6 sm:p-8 flex flex-col justify-between hover:border-[#C5A46D]/60 transition-all duration-300 shadow-xl relative overflow-hidden">
                <div>
                  {/* COPERTINA ANTEPRIMA / PREVIEW */}
                  <div className="relative w-full h-60 sm:h-72 rounded-2xl overflow-hidden mb-6 bg-zinc-900 border border-zinc-800/80 group-hover:scale-[1.01] transition-transform duration-500">
                    <img
                      src={trendingArticle.coverUrl}
                      alt={trendingArticle.title}
                      className="w-full h-full object-cover opacity-80 group-hover:opacity-95 transition-opacity duration-500"
                    />
                    <div className="absolute inset-0 bg-gradient-to-t from-[#151515] via-transparent to-black/40" />

                    {/* BADGE TRENDING / IN EVIDENZA STILE YOUTUBE */}
                    <div className="absolute top-4 left-4 flex items-center gap-2">
                      <span className="inline-flex items-center gap-1.5 bg-[#C5A46D] text-black font-bold text-xs px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-lg">
                        <Flame size={14} className="fill-black" />
                        #1 In Evidenza
                      </span>
                      <span className="inline-flex items-center gap-1 bg-black/70 backdrop-blur text-white text-xs px-3 py-1 rounded-full font-mono border border-white/10">
                        <TrendingUp size={12} className="text-[#C5A46D]" />
                        {trendingArticle.views} letture
                      </span>
                    </div>

                    {/* DATA / DATASTAMP */}
                    <div className="absolute bottom-3 left-4 text-[10px] font-mono tracking-widest text-[#C5A46D] uppercase bg-black/60 backdrop-blur px-2.5 py-1 rounded-md border border-white/5">
                      {trendingArticle.date}
                    </div>

                    {/* PULSANTE RIPRODUZIONE / LETTURA RAPIDA */}
                    <div className="absolute right-4 bottom-3 w-10 h-10 rounded-full bg-[#C5A46D] text-black flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                      <Play size={18} className="fill-black ml-0.5" />
                    </div>
                  </div>

                  {/* TITOLO E SOTTOTITOLO */}
                  <h1 className="text-3xl sm:text-4xl md:text-5xl font-serif leading-tight group-hover:text-[#C5A46D] transition-colors duration-300">
                    {trendingArticle.title}
                  </h1>
                  {trendingArticle.subtitle && (
                    <h2 className="text-[#C5A46D] text-xl sm:text-2xl font-serif mt-2 italic">
                      {trendingArticle.subtitle}
                    </h2>
                  )}

                  <p className="mt-4 text-zinc-400 text-sm sm:text-base leading-relaxed max-w-2xl line-clamp-2">
                    {trendingArticle.summary}
                  </p>
                </div>

                <div className="mt-6 pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500">
                  <span className="flex items-center gap-2">
                    <span className="text-zinc-300 font-medium">
                      {trendingArticle.category}
                    </span>
                    <span>•</span>
                    <span>{trendingArticle.time} di lettura</span>
                    <span>•</span>
                    <span>Salvemini Times</span>
                  </span>
                  <span className="inline-flex items-center gap-1 text-[#C5A46D] font-semibold group-hover:translate-x-1.5 transition-transform">
                    Leggi ora <ChevronRight size={14} />
                  </span>
                </div>
              </div>
            </Link>

            {/* VOX POPULI SONDAGGIO */}
            <div
              id="vox-populi"
              className="rounded-3xl bg-[#151515] border border-zinc-800 p-6 sm:p-8 flex flex-col justify-between shadow-md"
            >
              <div>
                <div className="flex items-center justify-between mb-4">
                  <span className="uppercase tracking-[0.25em] text-xs font-bold text-[#C5A46D]">
                    Vox Populi
                  </span>
                  <span className="text-xs text-zinc-500 font-mono">Sondaggio</span>
                </div>

                <h3 className="text-xl font-serif font-medium leading-snug mb-6 text-zinc-100">
                  La settimana corta su 5 giorni migliorerebbe la scuola?
                </h3>

                <div className="space-y-5">
                  <div className="space-y-1.5">
                    <div className="flex justify-between text-sm font-medium">
                      <span className="text-zinc-200">SÌ</span>
                      <span className="text-[#C5A46D]">{pollVotes.yes}%</span>
                    </div>
                    <div className="h-2 bg-zinc-800 rounded-full overflow-hidden">
                      <div
                        className="h-full bg-[#C5A46D] rounded-full transition-all duration-500"
                        style={{ width: `${pollVotes.yes}%` }}
                      />
                    </div>
                  </div>

                  <div className="space-y-1.5">
                    <div className="flex justify-between text-sm font-medium">
                      <span className="text-zinc-200">NO</span>
                      <span className="text-zinc-400">{pollVotes.no}%</span>
                    </div>
                    <div className="h-2 bg-zinc-800 rounded-full overflow-hidden">
                      <div
                        className="h-full bg-zinc-600 rounded-full transition-all duration-500"
                        style={{ width: `${pollVotes.no}%` }}
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div className="mt-6 pt-4 border-t border-zinc-800/80">
                <div className="text-xs text-zinc-500 mb-4 flex items-center gap-1.5">
                  <span>🗳 {pollVotes.total} voti registrati</span>
                </div>

                {voted ? (
                  <p className="text-center text-xs text-[#C5A46D] font-medium py-2 bg-[#C5A46D]/10 rounded-xl">
                    ✓ Voto salvato
                  </p>
                ) : (
                  <div className="flex gap-3">
                    <button
                      onClick={() => handleVote("yes")}
                      className="flex-1 bg-[#C5A46D] hover:bg-[#b3925c] text-black py-2.5 rounded-xl font-semibold text-sm transition"
                    >
                      Vota SÌ
                    </button>
                    <button
                      onClick={() => handleVote("no")}
                      className="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white py-2.5 rounded-xl font-semibold text-sm transition"
                    >
                      Vota NO
                    </button>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>

        {/* TRENDING TICKER EDITORIALE */}
        <section className="px-8 py-6">
          <div className="bg-[#151515]/60 border border-zinc-800/80 rounded-2xl p-3.5 flex items-center gap-4 overflow-x-auto no-scrollbar">
            <span className="text-xs font-bold uppercase tracking-widest text-[#C5A46D] whitespace-nowrap flex items-center gap-1.5 shrink-0 border-r border-zinc-800/80 pr-4">
              <Flame size={15} /> Trending
            </span>
            <div className="flex items-center gap-6 text-sm text-zinc-300 whitespace-nowrap">
              {[
                "🔥 Open Day",
                "🔥 Torneo d'istituto",
                "🔥 Assemblea",
                "🔥 Playlist studenti",
                "🔥 Laboratori STEM",
              ].map((item, idx) => (
                <span
                  key={idx}
                  className="hover:text-[#C5A46D] cursor-pointer transition flex items-center gap-2 font-medium"
                >
                  {item}
                  {idx < 4 && <span className="text-zinc-700 ml-2">•</span>}
                </span>
              ))}
            </div>
          </div>
        </section>

        {/* ULTIMI ARTICOLI CON FILTRI */}
        <section className="px-8 pb-12">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <h2 className="text-2xl font-serif text-[#C5A46D] font-bold">
              Ultimi Articoli
            </h2>

            {/* CHIP FILTRI CATEGORIE */}
            <div className="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 no-scrollbar">
              {categories.map((cat) => (
                <button
                  key={cat}
                  onClick={() => setSelectedCategory(cat)}
                  className={`px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all ${
                    selectedCategory === cat
                      ? "bg-[#C5A46D] text-black font-semibold shadow-sm"
                      : "bg-[#151515] border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700"
                  }`}
                >
                  {cat}
                </button>
              ))}
            </div>
          </div>

          {/* GRIGLIA ARTICOLI */}
          {filteredArticles.length === 0 ? (
            <div className="p-12 text-center text-zinc-500 bg-[#151515] rounded-3xl border border-zinc-800">
              Nessun articolo trovato per i filtri selezionati.
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {filteredArticles.map((article) => (
                <Link key={article.id} href={`/articolo/${article.id}`}>
                  <div className="bg-[#151515] rounded-3xl overflow-hidden border border-zinc-800 hover:border-[#C5A46D]/60 hover:-translate-y-1 transition-all duration-300 cursor-pointer h-full flex flex-col group">
                    <div className="h-48 relative overflow-hidden bg-zinc-900">
                      <img
                        src={article.coverUrl}
                        alt={article.title}
                        className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
                      />
                      <div className="absolute inset-0 bg-gradient-to-t from-[#151515] via-transparent to-black/20" />
                      <span className="absolute top-3 left-3 text-[11px] font-semibold uppercase tracking-wider text-[#C5A46D] bg-[#111111]/80 backdrop-blur px-3 py-1 rounded-full border border-zinc-800">
                        {article.category}
                      </span>
                      <span className="absolute bottom-3 right-3 text-zinc-300 text-xs flex items-center gap-1 bg-black/60 backdrop-blur px-2.5 py-1 rounded-md font-mono border border-white/10">
                        <Clock size={12} /> {article.time}
                      </span>
                    </div>

                    <div className="p-6 flex-1 flex flex-col justify-between">
                      <div>
                        <h3 className="font-serif text-xl font-bold mb-3 group-hover:text-[#C5A46D] transition line-clamp-2">
                          {article.title}
                        </h3>
                        <p className="text-zinc-400 text-sm line-clamp-2 leading-relaxed mb-4">
                          {article.summary}
                        </p>
                      </div>

                      <div className="pt-4 border-t border-zinc-800/60 flex items-center justify-between text-xs text-zinc-500">
                        <span>Di {article.author}</span>
                        <span className="text-[#C5A46D] opacity-0 group-hover:opacity-100 transition-opacity font-medium flex items-center gap-1">
                          Leggi <ChevronRight size={12} />
                        </span>
                      </div>
                    </div>
                  </div>
                </Link>
              ))}
            </div>
          )}
        </section>
      </main>
    </div>
  );
}
